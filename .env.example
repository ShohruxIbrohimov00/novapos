# NovaPOS sozlamalari — bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zgartiring.

# production bo'lsa /docs yopiladi va CORS cheklanadi
ENVIRONMENT=production

# MAJBURIY: uzun tasodifiy satr. Yaratish:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Baza (bo'sh qoldirilsa novapos.db SQLite ishlatiladi)
# DATABASE_URL=postgresql://user:parol@localhost:5432/novapos
DATABASE_URL=sqlite:///./novapos.db

# Sayt manzili (vergul bilan bir nechta)
ALLOWED_ORIGINS=https://sizning-domen.uz

# Superadmin — server birinchi ishga tushganda yaratiladi
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME=Super Admin

# AI Scan (ixtiyoriy)
GEMINI_API_KEY=
